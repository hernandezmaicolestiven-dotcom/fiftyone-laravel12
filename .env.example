APP_NAME=FiftyOne
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://tudominio.com

# ── SEGURIDAD ────────────────────────────────────────────────────────────────
# En producción: APP_DEBUG=false, APP_ENV=production
# APP_KEY se genera con: php artisan key:generate
# BCRYPT_ROUNDS: mínimo 12 recomendado (mayor = más seguro pero más lento)
BCRYPT_ROUNDS=12

# SESSION: usar 'database' o 'redis' en producción, nunca 'file' en multi-server
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# ── BASE DE DATOS ────────────────────────────────────────────────────────────
# NUNCA usar root sin contraseña en producción
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fifty_one
DB_USERNAME=db_user
DB_PASSWORD=db_password_segura

# ── CORREO ───────────────────────────────────────────────────────────────────
# En producción usar SMTP real (Mailgun, SES, Resend, etc.)
# NUNCA exponer credenciales en el código fuente
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fifty_one
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── WOMPI PAYMENT GATEWAY ───────────────────────────────────────────────────
# Configuración para Wompi (Pasarela de pagos Colombia)
# Documentación: https://docs.wompi.co/docs/colombia/
#
# SANDBOX (Pruebas):
# - Obtén tus llaves de prueba en: https://comercios.wompi.co/
# - Las llaves de sandbox tienen prefijo: pub_test_ y prv_test_
# - Tarjetas de prueba: https://docs.wompi.co/docs/colombia/datos-de-prueba-en-sandbox
#
# PRODUCCIÓN:
# - Las llaves de producción tienen prefijo: pub_prod_ y prv_prod_
# - Cambia WOMPI_SANDBOX=false para activar producción
# - NUNCA expongas las llaves privadas en el frontend
#
WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_PRIVATE_KEY=prv_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_INTEGRITY_SECRET=test_integrity_XXXXXXXXXXXXXXXX
WOMPI_EVENTS_SECRET=test_events_XXXXXXXXXXXXXXXX
WOMPI_SANDBOX=true
